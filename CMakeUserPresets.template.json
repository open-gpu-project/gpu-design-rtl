{
   "version": 2,
   "configurePresets": [
      {
         "name": "default",
         "inherits": "vcpkg-template-preset",
         "environment": {
            "VCPKG_ROOT": "path to vcpkg root"
         },
         "cacheVariables": {
            "CMAKE_C_COMPILER": "path to clang",
            "CMAKE_CXX_COMPILER": "path to clang++"
         }
      }
   ]
}